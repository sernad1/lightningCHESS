generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"

}

enum GameStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum GameResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
}

enum MatchType {
  VS_AI
  ONLINE
} // new

enum TimeControlMode {
  BULLET
  BLITZ
  RAPID
  CLASSICAL
  CHESS960
} // new

model User {
  id        String   @id @default(cuid()) 
  username  String   
  email     String   @unique
  password String?
  boardTheme String @default("classic")
  pieceTheme String @default("classic")
  isPremium Boolean @default(false)
  wins Int @default(0)
  losses Int @default(0)
  draws Int @default(0)
  gamesAsWhite Game[] @relation("WhitePlayer")
  gamesAsBlack Game[] @relation("BlackPlayer")
  solvedPuzzles SolvedPuzzle[]
  createdAt DateTime @default(now())
}

model Game{
  id String @id @default(cuid()) 
  whitePlayerId String?
  whitePlayer User? @relation("WhitePlayer", fields:[whitePlayerId], references: [id])
  blackPlayerId String?
  blackPlayer User? @relation("BlackPlayer", fields:[blackPlayerId], references: [id])
  matchType MatchType @default(ONLINE) // change
  timeControlMode TimeControlMode @default(RAPID) // change
  status GameStatus @default(WAITING) 
  result GameResult? 
  pgn String? @db.Text
  fen String? 
  whiteTimeRemainingMs Int?
  blackTimeRemainingMs Int?
  lastMoveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 

  @@index([whitePlayerId, status])
  @@index([blackPlayerId, status])

}
model Puzzle{
  id Int @id @default(autoincrement()) 
  fen String
  solution String
  difficulty Int
  solvers SolvedPuzzle[]
}

model SolvedPuzzle{
  userId String
  user User @relation(fields:[userId], references: [id], onDelete: Cascade)
  puzzleId Int
  puzzle Puzzle @relation(fields: [puzzleId], references: [id])
  solvedAt DateTime @default(now())
  @@id([userId, puzzleId])
}