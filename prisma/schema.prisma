// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"

}

enum GameStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum GameResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
}

model User {
  id        String   @id @default(cuid()) // changed id to cuid (string) for AuthJS compatability
  username  String   @unique
  email     String   @unique
  password String?
  boardTheme String @default("classic")
  pieceTheme String @default("classic")
  isPremium Boolean @default(false)
  wins Int @default(0)
  losses Int @default(0)
  draws Int @default(0)
  gamesAsWhite Game[] @relation("WhitePlayer")
  gamesAsBlack Game[] @relation("BlackPlayer")
  solvedPuzzles SolvedPuzzle[]
  createdAt DateTime @default(now())
}

model Game{
  id String @id @default(cuid()) // changed id to cuid (string) for safe game rooms
  whitePlayerId String?
  whitePlayer User? @relation("WhitePlayer", fields:[whitePlayerId], references: [id])
  blackPlayerId String?
  blackPlayer User? @relation("BlackPlayer", fields:[blackPlayerId], references: [id])
  mode String @default("standard")
  status GameStatus @default(WAITING) // replaced with enum to accomodate different game statuses (ABANDONED, COMPLETED, ETC.)
  result GameResult? // replaced with enum to accomodate different game outcomes (DRAW, BLACK WIN, etc.)
  pgn String? @db.Text
  fen String? 
  // new block to allow clock sync in games
  timeControl String? // 3+2, 10+0, etc.
  whiteTimeRemainingMs Int?
  blackTimeRemainingMs Int?
  lastMoveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // nuzno sztoby otslezivat izmeniniya v igre vrode

  // dynamic lookup tables to avoid full-table scans for game history, reconnecting to game, etc.
  @@index([whitePlayerId, status])
  @@index([blackPlayerId, status])

}
model Puzzle{
  id Int @id @default(autoincrement()) 
  fen String
  solution String
  difficulty Int
  solvers SolvedPuzzle[]
}

model SolvedPuzzle{
  userId String
  user User @relation(fields:[userId], references: [id])
  puzzleId Int
  puzzle Puzzle @relation(fields: [puzzleId], references: [id])
  solvedAt DateTime @default(now())
  @@id([userId, puzzleId])
}