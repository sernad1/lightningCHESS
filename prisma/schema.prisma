// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id        String   @id
  username  String   @unique
  email     String   @unique
  boardTheme String @default("classic")
  pieceTheme String @default("classic")
  isPremium Boolean @default(false)
  wins Int @default(0)
  losses Int @default(0)
  draws Int @default(0)
  gamesAsWhite Game[] @relation("WhitePlayer")
  gamesAsBlack Game[] @relation("BlackPlayer")
  solvedPuzzles SolvedPuzzle[]
  createdAt DateTime @default(now())
}

model Game{
  id Int @id @default(autoincrement())
  whitePlayerId String?
  whitePlayer User? @relation("WhitePlayer", fields:[whitePlayerId], references: [id])
  blackPlayerId String?
  blackPlayer User? @relation("BlackPlayer", fields:[blackPlayerId], references: [id])
  mode String
  pgn String ? @db.Text
  fen String?
  result String?
  createdAt DateTime @default(now())
}
model Puzzle{
  id Int @id @default(autoincrement())
  fen String
  solution String
  difficulty Int
  solvers SolvedPuzzle[]
}
model SolvedPuzzle{
  userId String
  user User @relation(fields:[userId], references: [id])
  puzzleId Int
  puzzle Puzzle @relation(fields: [puzzleId], references: [id])
  @@id([userId, puzzleId])
}